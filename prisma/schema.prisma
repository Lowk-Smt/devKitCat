generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryIcon {
  SYSTEMS
  UI_KITS
  ASSETS_3D
  VFX
  AUDIO
  DEVELOPER_TOOLS
  TEMPLATES
  COMPLETE_KITS
}

enum ProductType {
  SYSTEM
  UI_KIT
  STARTER_KIT
  MODEL_PACK
  VFX_PACK
}

enum OrderStatus {
  COMPLETE
  PROCESSING
  REFUNDED
  /// Submitted through checkout but not paid: no payment provider is connected
  /// yet, so an order in this state grants no download entitlement.
  PENDING_PAYMENT
}

enum DownloadStatus {
  PENDING
  AVAILABLE
  REVOKED
}

enum ThemePreference {
  DARK
  SYSTEM
}

/// Access levels for the private creator-management surface.
///
/// A grant is a `StaffMembership` row, never a column on `Customer`: signup,
/// profile edits, and request bodies have no field that could express one, so
/// an account cannot promote itself. Future creator-facing work (applications,
/// creator profiles, per-creator product ownership) gets its own tables and
/// its own privilege checks, and can never satisfy `StaffPrivilege` because
/// those are resolved from this enum only.
enum StaffRole {
  OWNER
  STAFF
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  icon        CategoryIcon
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([sortOrder, slug])
}

model Product {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  title                String
  description          String
  overview             String[]    @default([])
  price                Decimal     @db.Decimal(10, 2)
  type                 ProductType
  version              String
  features             String[]    @default([])
  requirements         String[]    @default([])
  includedFiles        String[]    @default([])
  installation         String[]    @default([])
  documentationSummary String
  documentationTopics  String[]    @default([])
  license              String
  releasedAt           DateTime    @db.Date
  isFeatured           Boolean     @default(false)
  isNew                Boolean     @default(false)
  published            Boolean     @default(false)
  sortOrder            Int         @default(0)
  categoryId           String
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images        ProductImage[]
  modelPreviews ProductModelPreview[]
  changelog     ProductChangelogEntry[]
  orderItems    OrderItem[]
  downloads     Download[]
  cartItems     CartItem[]

  @@index([categoryId, published, sortOrder])
  @@index([published, isFeatured, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  src       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

model ProductModelPreview {
  id          String   @id @default(cuid())
  productId   String
  src         String
  label       String
  description String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

model ProductChangelogEntry {
  id        String   @id @default(cuid())
  productId String
  version   String
  date      DateTime @db.Date
  notes     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, position])
  @@index([productId, date])
}

model Customer {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  /// scrypt password digest. Null means the record cannot sign in (for example
  /// the seeded marketplace fixture customer, which is data-only).
  passwordHash    String?
  /// Profile preferences edited on /account/settings.
  themePreference ThemePreference @default(DARK)
  productUpdates  Boolean         @default(true)
  releaseNotes    Boolean         @default(false)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  orders    Order[]
  downloads Download[]
  sessions  Session[]
  cartItems CartItem[]

  /// Present only for explicitly authorized staff. `null` means "ordinary
  /// customer", which is the state every newly registered account is in.
  staffMembership         StaffMembership?  @relation("StaffMembershipHolder")
  grantedStaffMemberships StaffMembership[] @relation("StaffMembershipGrantor")
}

/// One staff grant: which `Customer` may manage the marketplace, and how far.
///
/// Kept in its own table so a grant can be issued, audited, and revoked without
/// touching the customer record, and so no user-facing write path can reach it.
/// `grantedByCustomerId` records who issued it, so a second OWNER can never
/// appear unexplained. It is null only for a row the bootstrap CLI wrote, where
/// the actor is an operator with database access rather than a customer.
model StaffMembership {
  id                  String    @id @default(cuid())
  customerId          String    @unique
  role                StaffRole @default(STAFF)
  grantedByCustomerId String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  customer  Customer  @relation("StaffMembershipHolder", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grantedBy Customer? @relation("StaffMembershipGrantor", fields: [grantedByCustomerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([role])
  @@index([grantedByCustomerId])
}

/// Server-side session records. Only the SHA-256 hash of the opaque cookie
/// token is stored, so a database leak cannot be replayed as a session.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// One saved line in a signed-in customer's cart.
///
/// Carts belong to a `Customer` row, never to an anonymous browser: without a
/// verified session there is nothing to own a row, so the storefront keeps its
/// existing browser-local cart instead. `customerId` + `productId` is unique,
/// which makes "add this product again" a quantity change rather than a second
/// line. Prices are never stored here — they are always read from `Product`.
model CartItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model Order {
  id             String      @id @default(cuid())
  customerId     String
  status         OrderStatus
  total          Decimal     @db.Decimal(10, 2)
  currency       String      @default("USD") @db.VarChar(3)
  customerName   String?     @db.VarChar(120)
  customerPhone  String?     @db.VarChar(32)
  /// Historical: checkout collected an optional Telegram username until the
  /// deep-link connection flow replaced it. Kept for old rows; nothing writes
  /// it anymore.
  telegramHandle String?     @db.VarChar(64)
  /// Client-supplied, server-validated checkout token. It lets a retried or
  /// double-submitted checkout resolve to the order it already created instead
  /// of creating a second one; uniqueness is enforced per customer below. Null
  /// for the seeded historical orders, which predate checkout.
  idempotencyKey String?   @db.VarChar(64)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        OrderItem[]
  telegramLink OrderTelegramLink?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  productTitle      String
  productSlug       String
  categorySlug      String
  categoryName      String
  versionAtPurchase String
  unitPrice         Decimal  @db.Decimal(10, 2)
  quantity          Int      @default(1)
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  download Download?

  @@unique([orderId, productId])
  @@index([productId])
}

model Download {
  id          String         @id @default(cuid())
  customerId  String
  productId   String
  orderItemId String?        @unique
  status      DownloadStatus @default(PENDING)
  fileKey     String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([customerId, createdAt])
  @@index([productId])
}

/// One order's Telegram connection: a one-time deep-link token (stored only as
/// a SHA-256 hash) and, once the customer presses Start in the bot, the private
/// chat that order conversations happen in.
///
/// The raw token is never persisted — like `Session.tokenHash`, a database leak
/// cannot be replayed as a link. `orderId` is unique, so an order has at most
/// one connection row; issuing a fresh link updates this row (new token,
/// cleared claim) rather than creating a second one. Connection status is
/// derived, not stored: `chatId` set means connected, an unconsumed row whose
/// `expiresAt` has passed is simply an expired link.
model OrderTelegramLink {
  id           String    @id @default(cuid())
  orderId      String    @unique
  /// SHA-256 hex of the raw deep-link token; lookups go through this hash.
  tokenHash    String    @unique @db.VarChar(64)
  expiresAt    DateTime  @db.Timestamptz(3)
  /// Set exactly once, by the atomic claim, when the customer presses Start.
  consumedAt   DateTime? @db.Timestamptz(3)
  /// Telegram private-chat id of the connected customer (numeral string, so
  /// int64 chat ids stay exact). Null until the token is claimed.
  chatId       String?   @db.VarChar(32)
  connectedAt  DateTime? @db.Timestamptz(3)
  /// Telegram profile name at connect time, shown to staff for orientation.
  telegramName String?   @db.VarChar(120)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  order  Order                @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  relays TelegramStaffRelay[]

  @@index([chatId])
}

/// Maps one relayed staff-chat message to the customer chat that sent it, so
/// the owner can answer with Telegram's normal Reply action and the webhook can
/// route the reply to the right customer. Identifier rows only — never message
/// content — so this is routing state, not a conversation history.
///
/// `sourceUpdateId`/`sourceKind` make outbound sends retry-safe: before the
/// webhook (re)sends a relay, notice, or forward it checks whether this update
/// already produced one, so a redelivered update after a transient failure can
/// fill in missing state without sending the same message twice.
model TelegramStaffRelay {
  id             String   @id @default(cuid())
  linkId         String
  staffChatId    String   @db.VarChar(32)
  /// The message id our bot received from Telegram for its own relayed message
  /// in the staff chat. Unique per staff chat, which is what makes a native
  /// Telegram Reply resolvable to exactly one customer connection.
  staffMessageId String   @db.VarChar(32)
  /// The webhook update that produced this relay (dedup key for retries).
  sourceUpdateId String?  @db.VarChar(24)
  /// What kind of staff message this row maps: "relay", "connect-notice",
  /// "forward", or "media-notice".
  sourceKind     String?  @db.VarChar(16)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  link OrderTelegramLink @relation(fields: [linkId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([staffChatId, staffMessageId])
  @@index([linkId])
  @@index([sourceUpdateId])
}

/// Webhook processing state per Telegram update id. Telegram redelivers
/// updates it has not seen acknowledged, so this table is the retry-safe
/// ledger:
///
/// * `status = "processing"` with a live `leaseUntil` means one delivery is
///   working on it — concurrent duplicates skip. An expired lease can be
///   stolen atomically by a retry.
/// * `status = "done"` is permanent: a redelivered update is dropped.
/// * A failed attempt releases the lease and the webhook answers 500, so
///   Telegram retries and the update is not lost.
///
/// The message-id markers record which customer-facing message an update
/// already delivered, so a retry re-sends nothing that arrived.
model TelegramWebhookEvent {
  updateId   String    @id @db.VarChar(24)
  status     String    @default("processing") @db.VarChar(16)
  /// Claim lease; null once the update is done.
  leaseUntil DateTime? @db.Timestamptz(3)
  attempts   Int       @default(0)
  /// Our bot's customer-facing message for this update, when one was delivered.
  customerMessageId String? @db.VarChar(32)
  /// Our bot's delivery of a staff reply for this update, when it happened.
  staffReplyMessageId String? @db.VarChar(32)
  receivedAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}
