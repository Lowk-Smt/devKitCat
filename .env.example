# PostgreSQL connection string (safe local placeholder; replace for real use).
# Never commit .env or a real database URL. Configure DATABASE_URL in Vercel
# project environment variables for each deployment environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devkitcat?schema=public"

# Authentication is required for /account, /login, and /register. It is
# session-based: the browser cookie holds an opaque random token and only its
# SHA-256 hash is stored in the "Session" table, so there is no signing secret
# to configure and nothing below is sensitive. Passwords are hashed with scrypt
# using parameters fixed in src/lib/server/auth-core.ts.
#
# All of the following are optional; the defaults are shown and invalid values
# fall back to them. Session cookies are always HttpOnly and SameSite=Lax, and
# Secure whenever NODE_ENV is "production".

# Lifetime of a normal sign-in session, in whole days (1-365).
AUTH_SESSION_MAX_AGE_DAYS="7"

# Lifetime when "Remember me" is checked, in whole days (1-365). It is never
# shorter than AUTH_SESSION_MAX_AGE_DAYS.
AUTH_REMEMBER_ME_MAX_AGE_DAYS="30"

# Uncomment to force Secure session cookies in a non-production HTTPS preview.
# This can only turn Secure cookies on; production always uses them.
# AUTH_COOKIE_SECURE="true"
