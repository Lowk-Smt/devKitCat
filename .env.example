# PostgreSQL connection string (safe local placeholder; replace for real use).
# Never commit .env or a real database URL. Configure DATABASE_URL in Vercel
# project environment variables for each deployment environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devkitcat?schema=public"

# Authentication is required for /account, /login, and /register. It is
# session-based: the browser cookie holds an opaque random token and only its
# SHA-256 hash is stored in the "Session" table, so there is no signing secret
# to configure and nothing below is sensitive. Passwords are hashed with scrypt
# using parameters fixed in src/lib/server/auth-core.ts.
#
# All of the following are optional; the defaults are shown and invalid values
# fall back to them. Session cookies are always HttpOnly and SameSite=Lax, and
# Secure whenever NODE_ENV is "production".

# Lifetime of a normal sign-in session, in whole days (1-365).
AUTH_SESSION_MAX_AGE_DAYS="7"

# Lifetime when "Remember me" is checked, in whole days (1-365). It is never
# shorter than AUTH_SESSION_MAX_AGE_DAYS.
AUTH_REMEMBER_ME_MAX_AGE_DAYS="30"

# Telegram Order Notifications (Server-only — do NOT prefix with NEXT_PUBLIC_)
# devKitCat dispatches an order notification to your staff Telegram chat whenever
# an order is placed. The bot token and chat ID are read server-side only and
# are never exposed to browser clients.
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="-1001234567890"

# Telegram customer connection bot (Server-only — do NOT prefix with NEXT_PUBLIC_)
# With TELEGRAM_BOT_TOKEN set, the order confirmation page offers "Start
# Telegram": a one-time deep link that connects the customer's Telegram account
# to that specific order. The webhook (src/app/api/telegram/webhook) then
# relays customer messages into TELEGRAM_CHAT_ID, and you answer with
# Telegram's normal Reply action — the bot routes the reply to the customer.
#
# TELEGRAM_WEBHOOK_SECRET is required for the webhook: every Telegram delivery
# must echo it in the X-Telegram-Bot-Api-Secret-Token header. Generate one with
# `openssl rand -hex 32`, set it here AND register the webhook once per deploy:
#
#   node scripts/set-telegram-webhook.mjs --url https://YOUR-SITE/api/telegram/webhook
#
# TELEGRAM_WEBHOOK_SECRET="openssl-rand-hex-32-output"
#
# Optional, public (safe to expose): the bot's username, e.g. "devKitCatBot".
# Without it the app resolves the username server-side via getMe and caches it.
# TELEGRAM_BOT_USERNAME="devKitCatBot"
#
# Optional: deep-link lifetime in whole days (1-30). Default is 7.
# TELEGRAM_LINK_TTL_DAYS="7"

# Telegram Customer Contact (Client-safe public URL)
# Fallback used on the order confirmation screen only when the bot above is not
# configured: customers open Telegram, provide their Order ID, and coordinate
# manual payment and asset delivery by hand.
# NEXT_PUBLIC_TELEGRAM_CONTACT_URL="https://t.me/devKitCatSupport"

# Uncomment to force Secure session cookies in a non-production HTTPS preview.
# This can only turn Secure cookies on; production always uses them.
# AUTH_COOKIE_SECURE="true"

# Private creator management (Phase 1).
#
# Marketplace product management is limited to the owner and the staff an owner
# has granted. There is no shared staff password, no signing secret, and no
# public creator application: access is a `StaffMembership` row, and the only
# ways to create one are the owner's "Staff access" form on the private /manage
# page and the one-time bootstrap command below.
#
# MARKETPLACE_OWNER_EMAILS is read by `npm run db:grant-owner` and by nothing
# else. It is a list of already-registered customer addresses the operator
# chooses to promote to OWNER; it is never consulted during a request, so
# setting or clearing it cannot grant or revoke anything on its own. The command
# is a dry run unless --apply is passed, refuses an address that is not a
# registered customer, and never promotes the first or most recent signup.
#
#   npm run db:grant-owner -- --email you@example.com          # review only
#   npm run db:grant-owner -- --email you@example.com --apply  # write the grant
#
# Leave it unset once the first owner exists and grant further accounts from
# /manage instead, so every later change is visible in the staff directory.
# MARKETPLACE_OWNER_EMAILS="owner@example.com"
